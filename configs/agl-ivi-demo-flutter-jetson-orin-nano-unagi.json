{
    "id": "agl-ivi-demo-flutter-jetson-orin-nano-unagi",
    "load": false,
    "supported_archs": [
        "aarch64",
        "arm64",
        "x86_64"
    ],
    "supported_host_types": [
        "ubuntu",
        "fedora",
        "darwin"
    ],
    "flutter_version": "3.38.3",
    "type": "remote",
    "env": {
        "RELEASE_NAME": "unagi",
        "RELEASE_VERSION": "latest",
        "DEVICE_HOSTNAME": "jetson-orin-nano-devkit-nvme.local",
        "DEVICE_USER": "agl-driver",
        "PING_CMD": "ping -c 1 -w 400 ${DEVICE_HOSTNAME}",
        "FLUTTER_AUTO_EXE": "flutter-auto --j=/tmp/${appName}/default_config.json --b=/tmp/${appName}",
        "DELETE_USER_PWD": "ssh -t -oBatchMode=yes root@${DEVICE_HOSTNAME} passwd -d ${DEVICE_USER}",
        "CREATE_BUNDLE_FOLDER": "ssh -o BatchMode=yes ${DEVICE_USER}@${DEVICE_HOSTNAME} mkdir -p /tmp/${appName}/data",
        "COPY_PLATFORM_ID_TO_DEVICE": "scp -r ${PLATFORM_ID_DIR}/default_config.json ${DEVICE_USER}@${DEVICE_HOSTNAME}:/tmp/${appName}/",
        "COPY_ASSETS_TO_DEVICE": "scp -r ${localPath}/* ${DEVICE_USER}@${DEVICE_HOSTNAME}:/tmp/${appName}/data/flutter_assets",
        "DELETE_APP_FOLDER": "ssh -o BatchMode=yes ${DEVICE_USER}@${DEVICE_HOSTNAME} rm -rf /tmp/${appName}"
    },
    "runtime": {
        "config": {
            "view": [
                {
                    "window_type": "BG",
                    "width": 1920,
                    "height": 1080,
                    "fullscreen": true
                }
            ]
        }
    },
    "overwrite-existing": true,
    "custom-device": {
        "id": "agl-ivi-demo-flutter-jetson-orin-nano-unagi",
        "label": "AGL unagi Jetson Orin Nano (flutter-auto)",
        "sdkNameAndVersion": "AGL unagi Jetson Orin Nano devkit NVMe (flutter-auto)",
        "platform": "linux-arm64",
        "enabled": true,
        "ping": "bash -c \"${PING_CMD}\"",
        "pingSuccessRegex": "1 packets transmitted, 1 received",
        "postBuild": "bash -c \"${DELETE_USER_PWD}\"",
        "install": "bash -c \"${CREATE_BUNDLE_FOLDER} && ${COPY_PLATFORM_ID_TO_DEVICE} && ${COPY_ASSETS_TO_DEVICE}\"",
        "uninstall": "bash -c \"${DELETE_APP_FOLDER}\"",
        "runDebug": "bash -c \"ssh -t -t -o BatchMode=yes ${DEVICE_USER}@${DEVICE_HOSTNAME} ${FLUTTER_AUTO_EXE}\"",
        "forwardPort": "bash -c \"ssh -t -t -o BatchMode=yes -o ExitOnForwardFailure=yes -L 127.0.0.1:${hostPort}:127.0.0.1:${devicePort} ${DEVICE_USER}@${DEVICE_HOSTNAME} echo 'Port forwarding success'; read\"",
        "forwardPortSuccessRegex": "Port forwarding success",
        "screenshot": null
    }
}
